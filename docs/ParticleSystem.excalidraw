      "updated": 1791401107887,
      "created": 1791400640650,
      "link": null,
      "locked": false,
      "text": "    if(p.age < p.lifetime)\n    {\n        uint slot = atomicAdd(aliveWriteCount, 1);\n        aliveWrite[slot] = particleIndex;\n    } else {\n        uint slot = atomicAdd(deadCount, 1);\n        deadList[slot] = particleIndex;\n    }",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "9bHzb7sfAqHcFOp6nKIQq",
      "originalText": "    if(p.age < p.lifetime)\n    {\n        uint slot = atomicAdd(aliveWriteCount, 1);\n        aliveWrite[slot] = particleIndex;\n    } else {\n        uint slot = atomicAdd(deadCount, 1);\n        deadList[slot] = particleIndex;\n    }",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
