      "link": null,
      "locked": false,
      "text": "Compute:\n\nthread 0 -> particle 7\nthread 1 -> particle 6\nthread 2 -> particle 5\n\nuint particleIndex = AliveListRead[threadId];\n\nParticle p = particles[particleIndex];\np.position += p.velocity * dt;\np.age += dt;",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "_YhKEb1DZUsaacod3pyFW",
      "originalText": "Compute:\n\nthread 0 -> particle 7\nthread 1 -> particle 6\nthread 2 -> particle 5\n\nuint particleIndex = AliveListRead[threadId];\n\nParticle p = particles[particleIndex];\np.position += p.velocity * dt;\np.age += dt;",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
