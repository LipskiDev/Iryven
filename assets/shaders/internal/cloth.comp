#version 460

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct ClothParticle
{
    // xyz = current position
    // w   = inverse mass
    vec4 positionAndInverseMass;

    // xyz = previous position
    vec4 previousPosition;

    // xyz = normal
    vec4 normal;
};

layout(set = 0, binding = 0, std430) readonly buffer InputParticles
{
    ClothParticle particles[];
} inputParticles;

layout(set = 0, binding = 1, std430) buffer OutputParticles
{
    ClothParticle particles[];
} outputParticles;

layout(push_constant) uniform ClothSimulationConstants
{
    uint resolutionX;
    uint resolutionY;

    float clothWidth;
    float clothHeight;

    float deltaTime;
    float stiffness;
    float damping;
    float gravityScale;

    uint phase;
    uint iteration;
    uint solverIterations;
    uint particleCount;

    float time;
    vec2 padding;
} constants;


// Must match ClothSimulationPhase on the CPU.
const uint PHASE_INTEGRATE            = 0;
const uint PHASE_SOLVE_CONSTRAINTS    = 1;
const uint PHASE_RECALCULATE_NORMALS  = 2;


void Integrate(uint index)
{
    ClothParticle particle = inputParticles.particles[index];

    float inverseMass = particle.positionAndInverseMass.w;

    // Pinned particle.
    if (inverseMass == 0.0)
    {
        outputParticles.particles[index] = particle;
        return;
    }

    vec3 position = particle.positionAndInverseMass.xyz;
    vec3 previousPosition = particle.previousPosition.xyz;

    vec3 velocity = position - previousPosition;

    // Simple damping of the implicit velocity.
    velocity *= (1.0 - constants.damping);

    float windNoise =
        sin(constants.time) * 3;
    
    vec3 windAcceleration =
        vec3(0.0, 0.0, 10.0 * (windNoise));

    vec3 acceleration =
        vec3(0.0, -9.81, 0.0) * constants.gravityScale;// + windAcceleration;

    float dt = constants.deltaTime;

    vec3 newPosition =
        position
        + velocity
        + acceleration * dt * dt;

    particle.previousPosition.xyz = position;
    particle.positionAndInverseMass.xyz = newPosition;

    outputParticles.particles[index] = particle;
}

vec3 ConstraintCorrection(
    vec3 position,
    vec3 neighborPosition,
    float restLength)
{
    vec3 delta = neighborPosition - position;

    float distance = length(delta);

    if (distance < 1e-6)
        return vec3(0.0);

    float error = distance - restLength;

    return
        normalize(delta) *
        error *
        0.5 *
        constants.stiffness;
}


void SolveConstraints(uint index)
{
    ClothParticle particle = outputParticles.particles[index];

    float invMass = particle.positionAndInverseMass.w;

    if (invMass == 0.0)
        return;

    vec3 position = particle.positionAndInverseMass.xyz;

    uint x = index % constants.resolutionX;
    uint y = index / constants.resolutionX;

    float restX =
        constants.clothWidth /
        float(constants.resolutionX - 1);

    float restY =
        constants.clothHeight /
        float(constants.resolutionY - 1);

    vec3 totalCorrection = vec3(0.0);
    float totalWeight = 0.0;

    // left
    if (x > 0)
    {
        uint neighborIndex = index - 1;

        // compute correction toward restX
        ClothParticle neighbor = outputParticles.particles[neighborIndex];
        totalCorrection += ConstraintCorrection(position, neighbor.positionAndInverseMass.xyz, restX);
    }

    // right
    if (x + 1 < constants.resolutionX)
    {
        uint neighborIndex = index + 1;

        // compute correction toward restX
        ClothParticle neighbor = outputParticles.particles[neighborIndex];
        totalCorrection += ConstraintCorrection(position, neighbor.positionAndInverseMass.xyz, restX);
    }

    // up
    if (y > 0)
    {
        uint neighborIndex =
            index - constants.resolutionX;

        // compute correction toward restY
        ClothParticle neighbor = outputParticles.particles[neighborIndex];
        totalCorrection += ConstraintCorrection(position, neighbor.positionAndInverseMass.xyz, restY);
    }

    // down
    if (y + 1 < constants.resolutionY)
    {
        uint neighborIndex =
            index + constants.resolutionX;

        // compute correction toward restY
        ClothParticle neighbor = outputParticles.particles[neighborIndex];
        totalCorrection += ConstraintCorrection(position, neighbor.positionAndInverseMass.xyz, restY);
    }

    position += totalCorrection;

    outputParticles.particles[index]
        .positionAndInverseMass.xyz = position;
}

void RecalculateNormal(uint index)
{
    ClothParticle particle = outputParticles.particles[index];

    uint x = index % constants.resolutionX;
    uint y = index / constants.resolutionX;

    vec3 p = particle.positionAndInverseMass.xyz;
    vec3 normalSum = vec3(0.0);

    bool hasLeft  = x > 0;
    bool hasRight = x + 1 < constants.resolutionX;
    bool hasUp    = y > 0;
    bool hasDown  = y + 1 < constants.resolutionY;

    vec3 left;
    vec3 right;
    vec3 up;
    vec3 down;

    if (hasLeft)
        left = outputParticles.particles[index - 1]
            .positionAndInverseMass.xyz;

    if (hasRight)
        right = outputParticles.particles[index + 1]
            .positionAndInverseMass.xyz;

    if (hasUp)
        up = outputParticles.particles[index - constants.resolutionX]
            .positionAndInverseMass.xyz;

    if (hasDown)
        down = outputParticles.particles[index + constants.resolutionX]
            .positionAndInverseMass.xyz;

    // Accumulate normals from triangles surrounding this vertex.
    if (hasUp && hasLeft)
        normalSum += cross(up - p, left - p);

    if (hasRight && hasUp)
        normalSum += cross(right - p, up - p);

    if (hasDown && hasRight)
        normalSum += cross(down - p, right - p);

    if (hasLeft && hasDown)
        normalSum += cross(left - p, down - p);

    float lengthSq = dot(normalSum, normalSum);

    if (lengthSq > 1e-12)
        particle.normal = vec4(normalize(normalSum), 0.0);
    else
        particle.normal = vec4(0.0, 0.0, 1.0, 0.0);

    outputParticles.particles[index] = particle;
}


void main()
{
    uint index = gl_GlobalInvocationID.x;

    if (index >= constants.particleCount)
        return;

    switch (constants.phase)
    {
        case PHASE_INTEGRATE:
            Integrate(index);
            break;

        case PHASE_SOLVE_CONSTRAINTS:
            SolveConstraints(index);
            break;

        case PHASE_RECALCULATE_NORMALS:
            RecalculateNormal(index);
            break;
    }
}